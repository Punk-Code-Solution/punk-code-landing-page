{
  "functions": {
    "src/app.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/blog/radar/run?max=1",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/blog/radar/run?max=1",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/blog/radar/run?max=1",
      "schedule": "0 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/app.js"
    }
  ]
}

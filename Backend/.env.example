CLIENT_EMAIL=
CLIENT_PASS=

# Blog radar (RSS + Cursor Cloud Agents API)
CURSOR_API_KEY=
BLOG_CRON_SECRET=troque-por-um-segredo-forte

# Opcional: persistência em produção (Vercel). Sem Turso, o JSON em /data é o fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend Inbound (receber e-mails @inbound.punkcodesolution.com.br)
RESEND_API_KEY=
# Token opcional na URL: ?token=...
RESEND_WEBHOOK_TOKEN=
# Para onde encaminhar (padrão: CLIENT_EMAIL)
INBOUND_FORWARD_TO=

# Opcional: lista de modelos Cursor separados por vírgula
# CURSOR_MODELOS=composer-2.5,gpt-5.6-sol-medium

# Opcional: timeout e polling da API Cursor (ms)
# CURSOR_TIMEOUT_MS=180000
# CURSOR_POLL_MS=3000

CLIENT_EMAIL=
CLIENT_PASS=

# Blog radar (RSS + Gemini)
GEMINI_API_KEY=
# Alternativa aceita pelo código:
# GOOGLE_API_KEY=
BLOG_CRON_SECRET=troque-por-um-segredo-forte

# Opcional: persistência em produção (Vercel). Sem Turso, o JSON em /data é o fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend Inbound (receber e-mails @inbound.punkcodesolution.com.br)
RESEND_API_KEY=
# Token opcional na URL: ?token=...
RESEND_WEBHOOK_TOKEN=
# Para onde encaminhar (padrão: CLIENT_EMAIL)
INBOUND_FORWARD_TO=

# Opcional: lista de modelos Gemini separados por vírgula (ordem de tentativa)
# GEMINI_MODELOS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-flash
